{
  "name": "codealpha-release-board",
  "version": "1.0.0",
  "description": "Small Express web app deployed to Azure App Service through an Azure Pipelines CI/CD pipeline",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports', { recursive: true })\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Ahmed Elgammal",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  }
}
