# Copy to .env and change the passwords:  cp .env.example .env
# .env is ignored by git, so real passwords never end up in the repository.

JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-admin

# Account the agents use to fetch their connection secret (Agent/Connect permission only)
AGENT_CONNECT_USER=agent-connector
AGENT_CONNECT_PASSWORD=change-me-agent

JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_PUBLIC_URL=http://localhost:8080/

# Repository the task3-gradle-build job checks out
PIPELINES_REPO_URL=https://github.com/ahmedelgmal310/codealpha_tasks.git
